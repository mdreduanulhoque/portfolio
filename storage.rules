rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "748z57UkoWVK6Y3q8kvwFFEeLkl1";
    }

    // Profile images: public read, admin-only write (max 5MB, image/* content type)
    match /profile/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && (
          (fileName.matches('profile_image_.*')
            && request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'))
          ||
          (fileName.matches('resume_.*')
            && request.resource.size <= 10 * 1024 * 1024
            && request.resource.contentType == 'application/pdf')
        );
    }

    // Deny all other unmatched paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
