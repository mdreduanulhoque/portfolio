rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Updates collection: public articles can be read by anyone; private articles require auth.
    match /updates/{updateId} {
      allow read: if resource.data.isPublic == true || request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Default rules: Anyone can read, only authenticated users can write
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
