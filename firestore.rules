rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "748z57UkoWVK6Y3q8kvwFFEeLkl1";
    }

    // Updates / Blog posts: public posts are readable by anyone; private posts require admin
    match /updates/{updateId} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow write: if isAdmin();
    }

    // Public portfolio collections: readable by anyone, writable only by admin
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /social_links/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /education/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experience/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /achievements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /skills/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /classes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny all other unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
