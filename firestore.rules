rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == "748z57UkoWVK6Y3q8kvwFFEeLkl1" ||
        request.auth.token.email == "mdreduanulhoquesadik@gmail.com"
      );
    }

    // Updates / Blog posts: public posts are readable by anyone; private posts require admin
    match /updates/{updateId} {
      allow read: if resource.data.isPublic == true || isAdmin();
      allow write: if isAdmin();
    }

    // Public portfolio collections: readable by anyone, writable only by admin
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /social_links/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /education/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experience/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /achievements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /skills/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /classes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /certificates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    function isValidGalleryDoc(data) {
      return data.fileId is string && data.fileId.size() >= 10 && data.fileId.size() <= 128 &&
        data.driveUrl is string && data.driveUrl.size() <= 512 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 60)) &&
        (!('order' in data) || data.order is number) &&
        (!('isHidden' in data) || data.isHidden is bool) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /gallery/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidGalleryDoc(request.resource.data);
      allow delete: if isAdmin();
    }
    match /gallery_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny all other unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
